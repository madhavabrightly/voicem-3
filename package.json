{
  "name": "voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-controlled computer agent: Voice -> Understand -> Observe -> Act -> Verify -> Voice response",
  "scripts": {
    "dev": "node backend/api/server.js",
    "start": "node backend/api/server.js",
    "voice": "node voice/start.js",
    "voice:sim": "node voice/start.js --simulate",
    "ui": "node demo/voice-ui-demo.js",
    "ui:sim": "node demo/voice-ui-demo.js --simulate",
    "start:app": "node voice/start.js",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "build:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1 -BundleNode",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "assemblyai": "^4.41.1",
    "node-record-lpcm16": "^1.0.1",
    "onnxruntime-node": "^1.29.0",
    "pngjs": "^7.0.0"
  }
}
