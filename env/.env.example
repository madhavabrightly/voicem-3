# Voice Agent environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# HTTP API server
PORT=3000
HOST=127.0.0.1

# AssemblyAI (voice interface). Set the key to use the real STT/TTS integration.
# ASSEMBLYAI_API_KEY=your_key_here
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# OCR perception (PaddleOCR ONNX). Defaults to backend/perception/models.
# VOICE_AGENT_OCR_MODEL_DIR=
